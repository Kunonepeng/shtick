{"id":"sh/298ryl4v","kind":"textbox","name":"text","position":{"left":64,"top":170,"width":1152,"height":44},"text":"同一段6秒声音；两份均为未压缩PCM WAV。","style":{"fontSize":29.33,"typeface":"Alibaba PuHuiTi 3.0 55 Regular","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
